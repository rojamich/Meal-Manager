rules_version = '2';

// Security rules for Meal Manager sync.
//
// Model:
// - Each household is a root document `households/{householdId}`.
// - The household doc lists `memberIds: [uid, uid, ...]` and an immutable `ownerId`.
// - All shared data lives in subcollections of that household
//   (recipes, plannedMeals, pantryItems, etc.).
// - An invite-code lookup is stored in `inviteCodes/{code} = { householdId, expiresAt }`.
// - Any authenticated user (incl. anonymous) can read an unexpired invite code by exact
//   ID to redeem it, then add themselves to that household.
//
// Anyone NOT a member of a household cannot read or write its data.
//
// Deploy with:  firebase deploy --only firestore:rules
// (CI does this on push to main — see .github/workflows/deploy.yml)

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper — current uid must exist
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper — current uid is a member of this household
    function isMember(householdId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/households/$(householdId))
        && request.auth.uid in
             get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    function memberSet() {
      return resource.data.memberIds.toSet();
    }

    function nextMemberSet() {
      return request.resource.data.memberIds.toSet();
    }

    function selfSet() {
      return [request.auth.uid].toSet();
    }

    // ownerId is the anchor of the whole model — a member who could rewrite it could
    // take the household over, so it never changes after creation.
    function ownerUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    match /households/{householdId} {
      allow read: if isMember(householdId);

      // Create: any signed-in user, but they must be the sole member and the owner.
      allow create: if isSignedIn()
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isSignedIn() && ownerUnchanged() && (
        // Joining — add yourself and change nothing else about the member list.
        // (A non-member cannot touch any other field, because this is the only branch
        //  available to them and it pins memberIds exactly.)
        (
          !(request.auth.uid in resource.data.memberIds)
          && nextMemberSet() == memberSet().union(selfSet())
        )
        ||
        // Existing member — may edit household fields while leaving the roster alone,
        // and may remove themselves.
        (
          request.auth.uid in resource.data.memberIds
          && (
            nextMemberSet() == memberSet()
            || nextMemberSet() == memberSet().difference(selfSet())
            // The owner may also remove other members (never add), which is the way
            // back from a leaked invite code.
            || (
              request.auth.uid == resource.data.ownerId
              && memberSet().hasAll(request.resource.data.memberIds)
              && request.auth.uid in request.resource.data.memberIds
            )
          )
        )
      );

      // Only the owner can delete the household outright.
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.memberIds
        && (request.auth.uid == resource.data.ownerId
            || resource.data.memberIds.size() == 1);

      // Shared collections — full CRUD by household members only
      match /{collection}/{docId} {
        allow read, write: if isMember(householdId);
      }
    }

    // Invite codes — short doc { householdId, expiresAt } at /inviteCodes/{code}
    match /inviteCodes/{code} {
      // Readable by exact ID only, and only while unexpired. Codes minted before
      // expiry existed carry no stamp and stay readable until rotated.
      allow get: if isSignedIn()
        && (!("expiresAt" in resource.data) || resource.data.expiresAt > request.time);
      allow list: if false; // never enumerate codes

      // Members mint codes for their own household, and every new code must carry a
      // near-term expiry so a code shared once cannot be redeemed indefinitely.
      allow create: if isSignedIn()
        && request.resource.data.householdId is string
        && isMember(request.resource.data.householdId)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(2, 'd');

      allow delete: if isSignedIn()
        && isMember(resource.data.householdId);

      // Codes are immutable once created (delete + recreate to rotate)
      allow update: if false;
    }
  }
}
